{
    "name": "open-ida-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "description": "OpenIDA workspace: binary inspection, section maps, strings and patching on one engine",
    "keywords": ["binary", "pe", "elf", "macho", "debugging", "analysis", "wae"],
    "license": "Apache-2.0",
    "repository": "https://github.com/nyar-os/OpenIDA",
    "scripts": {
        "test:rust": "cargo test --release",
        "fmt": "cargo fmt --all",
        "p": "git push && git push --tags --prune",
        "reset": "git reset Head~ --soft",
        "check:rust": "cargo fmt -p open-ida-core -p open-ida-napi -- --check && cargo clippy -p open-ida-core -p open-ida-napi --all-targets -- -D warnings && cargo test -p open-ida-core -p open-ida-napi",
        "build:napi": "wae native build",
        "build:ts": "pnpm --filter @wae/open-ida run build",
        "build:ui": "pnpm --filter @wae/open-ida-ui run build",
        "build": "wae build",
        "stage:native": "wae native stage",
        "typecheck": "pnpm -r --filter \"./projects/packages/*\" run typecheck",
        "test": "pnpm -r --filter \"./projects/packages/*\" run test",
        "gui": "pnpm run build && pnpm --filter @wae/open-ida exec node ./dist/cli.js gui"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "@wae/wae": "0.0.6",
        "typescript": "^5.9.2"
    }
}
