                            <td>{{ row.rva }}</td>
                            <td>{{ row.patch }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="matrix__note">A suffix is not a support claim. Mach-O is header-only until section decoding lands.</p>
        </section>

        <section class="loop">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Intended loop</span>
                    <h2>Open, map, read, verify</h2>
