{
    "name": "@wae/open-ida",
    "version": "0.0.0",
    "private": true,
    "description": "Binary inspection on one engine: headers, sections, strings, hex and safe patches",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "open-ida": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "locales"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsc -p tsconfig.json && node --test dist/smoke.test.js"
    },
    "keywords": [
        "binary",
        "pe",
        "elf",
        "macho",
        "analysis",
        "wae"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-os/OpenIDA.git",
        "directory": "projects/packages/open-ida"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@wae/commander": "0.0.7"
    },
    "optionalDependencies": {
        "@wae/open-ida-darwin-arm64": "workspace:*",
        "@wae/open-ida-darwin-x64": "workspace:*",
        "@wae/open-ida-linux-arm64": "workspace:*",
        "@wae/open-ida-linux-x64": "workspace:*",
        "@wae/open-ida-win32-x64": "workspace:*"
    }
}
